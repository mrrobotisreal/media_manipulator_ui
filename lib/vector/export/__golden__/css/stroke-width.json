{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "line",
      "id": "stem",
      "x1": 20,
      "y1": 100,
      "x2": 180,
      "y2": 100,
      "stroke": "#111111",
      "strokeWidth": 1
    }
  ],
  "animations": [
    {
      "layerId": "stem",
      "property": "strokeWidth",
      "keyframes": [
        {
          "t": 0,
          "value": 1,
          "easing": "linear"
        },
        {
          "t": 1000,
          "value": 12,
          "easing": "easeOut"
        },
        {
          "t": 2000,
          "value": 1,
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "stem",
      "property": "stroke",
      "keyframes": [
        {
          "t": 0,
          "value": "none",
          "easing": "linear"
        },
        {
          "t": 500,
          "value": "#111111",
          "easing": "linear"
        }
      ]
    }
  ]
}
