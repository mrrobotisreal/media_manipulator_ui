{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "rect",
      "id": "bg",
      "x": 0,
      "y": 0,
      "width": 200,
      "height": 200,
      "fill": "#000000",
      "stroke": "#ffffff",
      "strokeWidth": 2
    },
    {
      "type": "ellipse",
      "id": "orb",
      "cx": 100,
      "cy": 100,
      "rx": 30,
      "ry": 30,
      "fill": "#ff0000"
    }
  ],
  "defs": {},
  "animations": [
    {
      "layerId": "orb",
      "property": "fill",
      "keyframes": [
        {
          "t": 0,
          "value": "#ff0000",
          "easing": "linear"
        },
        {
          "t": 1000,
          "value": "#00ff00",
          "easing": "linear"
        },
        {
          "t": 2000,
          "value": "rgba(0, 0, 255, 0.5)",
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "orb",
      "property": "strokeWidth",
      "keyframes": [
        {
          "t": 0,
          "value": 0,
          "easing": "linear"
        },
        {
          "t": 1000,
          "value": 6,
          "easing": "easeIn"
        },
        {
          "t": 2000,
          "value": 0,
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "bg",
      "property": "stroke",
      "keyframes": [
        {
          "t": 0,
          "value": "#ffffff",
          "easing": "hold"
        },
        {
          "t": 1000,
          "value": "none",
          "easing": "linear"
        }
      ]
    }
  ],
  "loop": false
}
