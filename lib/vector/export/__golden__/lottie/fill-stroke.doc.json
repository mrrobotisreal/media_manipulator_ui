{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "ellipse",
      "id": "badge",
      "cx": 100,
      "cy": 100,
      "rx": 60,
      "ry": 60,
      "fill": "#ffd700",
      "stroke": "#111111",
      "strokeWidth": 4,
      "strokeOpacity": 0.5,
      "strokeDasharray": [
        12,
        6,
        3
      ],
      "strokeDashoffset": 2,
      "strokeMiterlimit": 8,
      "strokeLinejoin": "bevel"
    }
  ],
  "animations": [
    {
      "layerId": "badge",
      "property": "stroke",
      "keyframes": [
        {
          "t": 0,
          "value": "#111111",
          "easing": "linear"
        },
        {
          "t": 2000,
          "value": "#ec4899",
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "badge",
      "property": "strokeWidth",
      "keyframes": [
        {
          "t": 0,
          "value": 4,
          "easing": "easeOut"
        },
        {
          "t": 2000,
          "value": 10,
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "badge",
      "property": "fill",
      "keyframes": [
        {
          "t": 0,
          "value": "none",
          "easing": "linear"
        },
        {
          "t": 1000,
          "value": "#ffd700",
          "easing": "linear"
        },
        {
          "t": 2000,
          "value": "rgba(255, 0, 0, 0.5)",
          "easing": "linear"
        }
      ]
    }
  ]
}
