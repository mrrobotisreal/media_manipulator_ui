{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "rect",
      "id": "sun",
      "x": 20,
      "y": 20,
      "width": 160,
      "height": 160,
      "fill": "url(#glow)",
      "stroke": "url(#rim) #000",
      "strokeWidth": 6
    }
  ],
  "defs": {
    "gradients": [
      {
        "type": "radial",
        "id": "glow",
        "cx": 0.5,
        "cy": 0.5,
        "r": 0.5,
        "fx": 0.35,
        "fy": 0.35,
        "stops": [
          {
            "offset": 0,
            "color": "#ffd933"
          },
          {
            "offset": 0.6,
            "color": "#ff6600",
            "opacity": 0.5
          },
          {
            "offset": 1,
            "color": "rgba(255, 0, 0, 0.25)"
          }
        ]
      },
      {
        "type": "linear",
        "id": "rim",
        "units": "userSpaceOnUse",
        "x1": 20,
        "y1": 20,
        "x2": 180,
        "y2": 180,
        "stops": [
          {
            "offset": 0,
            "color": "#111111"
          },
          {
            "offset": 1,
            "color": "#999999"
          }
        ]
      }
    ],
    "masks": [],
    "clipPaths": [],
    "filters": [],
    "symbols": []
  }
}
