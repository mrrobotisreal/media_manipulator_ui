{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "rect",
      "id": "once",
      "x": 0,
      "y": 0,
      "width": 10,
      "height": 10,
      "fill": "#000"
    }
  ],
  "animations": [
    {
      "layerId": "once",
      "property": "opacity",
      "keyframes": [
        {
          "t": 0,
          "value": 0,
          "easing": "linear"
        },
        {
          "t": 2000,
          "value": 1,
          "easing": "linear"
        }
      ]
    }
  ],
  "loop": false
}
