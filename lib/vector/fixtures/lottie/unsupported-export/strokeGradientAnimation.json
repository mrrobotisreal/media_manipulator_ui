{
  "version": 1,
  "canvas": {
    "width": 200,
    "height": 200
  },
  "duration": 2000,
  "fps": 24,
  "layers": [
    {
      "type": "rect",
      "id": "ring",
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100,
      "fill": "none",
      "stroke": "url(#g)",
      "strokeWidth": 4
    }
  ],
  "defs": {
    "gradients": [
      {
        "type": "linear",
        "id": "g",
        "x1": 0,
        "y1": 0,
        "x2": 1,
        "y2": 0,
        "stops": [
          {
            "offset": 0,
            "color": "#000"
          },
          {
            "offset": 1,
            "color": "#fff"
          }
        ]
      }
    ],
    "masks": [],
    "clipPaths": [],
    "filters": [],
    "symbols": []
  },
  "animations": [
    {
      "layerId": "ring",
      "property": "gradientStop[0].color",
      "keyframes": [
        {
          "t": 0,
          "value": "#000000",
          "easing": "linear"
        },
        {
          "t": 2000,
          "value": "#ffffff",
          "easing": "linear"
        }
      ]
    }
  ]
}
