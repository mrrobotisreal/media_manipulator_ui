# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are exposed to the browser.

# --- AdSense / ads ---
# AdSense is OFF unless this is 'true' AND NODE_ENV=production AND the
# page/placement/slot pass the guards in lib/adsenseConfig.ts.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# First-party mock ad previews (non-production only). Never loads Google.
NEXT_PUBLIC_MOCK_ADS_ENABLED=true
# Recommended for the AdSense review deployment:
#   NEXT_PUBLIC_ADSENSE_ENABLED=false
#   NEXT_PUBLIC_MOCK_ADS_ENABLED=false

# --- API / analytics ---
NEXT_PUBLIC_API_BASE_URL="https://api.media-manipulator.com/api"
NEXT_PUBLIC_ANALYTICS_BASE_URL="https://analytics.media-manipulator.com"
# The first-party analytics write key. REQUIRED — without it every /v1/capture
# request comes back 401 and no events are stored.
#
# It is a PUBLIC site key, not a secret: it ships in the JS bundle, and its job is
# to identify and rate-bucket a known client and to be cheaply rotatable when
# someone starts replaying it. Must match one of the analytics service's
# WRITE_KEYS. Use `mmk_web_dev` against a local service.
NEXT_PUBLIC_ANALYTICS_WRITE_KEY="mmk_web_dev"
# GA4 is kept as a slim CROSS-CHECK only: three events (page_view, sign_up,
# job_completed). First-party analytics is the source of truth.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-6J910CMHRY"
# NEXT_PUBLIC_MP_TOKEN is GONE. Mixpanel is removed, along with Firebase
# Analytics and Firebase Performance — three overlapping third-party analytics
# products were three processors to disclose for data we now collect ourselves.

# --- Firebase (web; public by design) ---
NEXT_PUBLIC_FB_API_KEY=""
NEXT_PUBLIC_FB_AUTH_DOMAIN=""
NEXT_PUBLIC_FB_PROJECT_ID=""
NEXT_PUBLIC_FB_STORAGE_BUCKET=""
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FB_APP_ID=""
NEXT_PUBLIC_FB_MEASUREMENT_ID=""
